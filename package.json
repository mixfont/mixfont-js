{
  "name": "mixfont",
  "version": "0.1.1",
  "description": "Official JavaScript client for the Mixfont API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test"
  },
  "keywords": [
    "mixfont",
    "font",
    "generation",
    "sdk"
  ],
  "author": "Mixfont",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixfont/mixfont-js.git"
  },
  "bugs": {
    "url": "https://github.com/mixfont/mixfont-js/issues"
  },
  "homepage": "https://github.com/mixfont/mixfont-js#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
